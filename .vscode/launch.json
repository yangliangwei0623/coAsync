{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug HTTP server",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/server",
      "args": [],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "externalConsole": false,
      "preLaunchTask": "Build Debug",
      "setupCommands": [
        {
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
