{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure Debug",
      "type": "process",
      "command": "cmake",
      "args": ["--preset", "debug"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Build Debug",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "debug"],
      "options": {"cwd": "${workspaceFolder}"},
      "dependsOn": "Configure Debug",
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": ["$gcc"]
    }
  ]
}
